<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE html>
<html b:version='2' class='v2' expr:dir='data:blog.languageDirection' xmlns='http://www.w3.org/1999/xhtml' xmlns:b='http://www.google.com/2005/gml/b' xmlns:data='http://www.google.com/2005/gml/data' xmlns:expr='http://www.google.com/2005/gml/expr'>
<head>
    <b:include data='blog' name='all-head-content'/>
    <title><data:blog.pageTitle/></title>
    <meta content='width=device-width, initial-scale=1' name='viewport'/>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&amp;family=Open+Sans:wght@400;600&amp;display=swap" rel="stylesheet"/>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <b:skin><![CDATA[
    /*
     * Blogger Skin
     * We leave this relatively empty to rely on our custom styles below
     */
    body { margin: 0; padding: 0; }
    ]]></b:skin>

    <!-- Custom Theme CSS -->
    <style>
    :root {
        /* Amazon-inspired Theme Palette */
        --color-bg-primary: #ffffff;
        --color-bg-secondary: #f3f3f3;
        --color-header: #232f3e;
        --color-header-light: #37475a;
        --color-accent-primary: #ff9900;
        --color-accent-hover: #e88b00;
        --color-accent-secondary: #007185;
        --color-text-primary: #111111;
        --color-text-secondary: #565959;
        --color-text-light: #ffffff;
        --color-border: #d5d9d9;
        --gradient-main: linear-gradient(to bottom, #232f3e, #37475a);
        --gradient-accent: linear-gradient(to bottom, #f7dfa5, #f0c14b);
        --font-heading: 'Roboto', 'Arial', sans-serif;
        --font-body: 'Open Sans', 'Arial', sans-serif;
        --spacing-container: 1200px;
        --spacing-xs: 0.5rem;
        --spacing-sm: 1rem;
        --spacing-md: 2rem;
        --spacing-lg: 4rem;
        --spacing-xl: 6rem;
        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 8px;
        --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.1);
        --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background-color: var(--color-bg-primary); color: var(--color-text-primary); font-family: var(--font-body); line-height: 1.6; overflow-x: hidden; width: 100%; }
    h1, h2, h3, h4, h5, h6 { font-family: var(--font-heading); font-weight: 700; color: var(--color-text-primary); line-height: 1.25; }
    a { text-decoration: none; color: inherit; transition: all 0.2s ease; }
    ul { list-style: none; padding: 0; }

    /* Utilities */
    .container { max-width: var(--spacing-container); margin: 0 auto; padding: 0 var(--spacing-sm); }
    .btn { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.75rem 1.5rem; border-radius: var(--radius-sm); font-weight: 500; cursor: pointer; transition: all 0.2s; border: 1px solid transparent; font-size: 1rem; }
    .btn-primary { background: var(--gradient-accent); border-color: #a88734 #9c7e31 #846a29; color: #111; }
    .btn-primary:hover { background: #f0c14b; }
    .btn-secondary { background: white; border: 1px solid var(--color-border); color: var(--color-text-primary); box-shadow: 0 2px 5px rgba(213, 217, 217, .5); }
    .btn-secondary:hover { background: #f7fafa; }
    .section-padding { padding: var(--spacing-xl) 0; }
    .text-gradient { background: var(--gradient-accent); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; display: inline-block; }

    /* Header */
    .site-header { background: var(--color-header); color: white; position: fixed; width: 100%; z-index: 1000; border-bottom: none; top: 0; left: 0; }
    .site-header .container { display: flex; justify-content: space-between; align-items: center; height: 80px; }
    .logo { font-size: 1.5rem; font-weight: bold; }
    .desktop-menu { display: flex; gap: 2rem; align-items: center; }
    .desktop-menu a { color: white; }
    .mobile-toggle { display: none; background: none; border: none; color: white; cursor: pointer; }

    /* Mobile Menu */
    .mobile-menu { position: absolute; top: 80px; left: 0; width: 100%; background: var(--color-header); display: none; flex-direction: column; padding: 1rem; border-top: 1px solid rgba(255,255,255,0.1); }
    .mobile-menu a { padding: 1rem; border-bottom: 1px solid rgba(255,255,255,0.05); color: white; }

    /* Footer */
    footer { background-color: #232f3e; color: white; padding: 4rem 0 0 0; margin-top: auto; }
    .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; padding-bottom: 3rem; }
    .footer-col h3 { color: #ff9900; margin-bottom: 1.5rem; }
    .footer-icons { display: flex; gap: 1rem; }
    .footer-icon-link { background: rgba(255,255,255,0.1); padding: 0.75rem; border-radius: 50%; display: flex; align-items: center; justify-content: center; }

    /* Blog Posts specific */
    .post-outer { margin-bottom: 2rem; background: white; border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 2rem; }
    .post-title { font-size: 2rem; margin-bottom: 1rem; }
    .post-title a { color: var(--color-text-primary); }
    .post-body { font-size: 1.1rem; color: var(--color-text-secondary); }
    
    /* Layout */
    .main-wrapper { margin-top: 80px; padding-top: 4rem; padding-bottom: 4rem; min-height: 60vh; }

    @media (max-width: 768px) {
        .section-padding { padding: var(--spacing-lg) 0; }
        .desktop-menu { display: none; }
        .mobile-toggle { display: block; }
    }
    </style>
</head>

<body>
    <!-- Header -->
    <header class="site-header">
        <div class="container">
            <a href="/" class="logo">
                Bechdenge<span class="text-gradient">.com</span>
            </a>

            <nav class="desktop-menu">
                <a href="/">Home</a>
                <a href="/p/services.html">Services</a>
                <a href="/p/certificates.html">Certificates</a>
                <a href="/p/gallery.html">Gallery</a>
                <a href="/p/resources.html">Resources</a>
                <a href="/p/booking.html" class="btn btn-primary" style="padding: 0.5rem 1rem">Book Now</a>
            </nav>

            <button class="mobile-toggle" id="mobile-menu-toggle">
                <i data-lucide="menu"></i>
            </button>
        </div>

        <div class="mobile-menu" id="mobile-menu">
            <a href="/">Home</a>
            <a href="/p/services.html">Services</a>
            <a href="/p/certificates.html">Certificates</a>
            <a href="/p/gallery.html">Gallery</a>
            <a href="/p/resources.html">Resources</a>
            <a href="/p/booking.html" class="btn btn-primary" style="margin: 1rem;">Book Now</a>
        </div>
    </header>

    <!-- Main Content -->
    <div class="container main-wrapper">
        <b:section class='main' id='main' showaddelement='yes'>
            <b:widget id='Blog1' locked='true' title='Blog Posts' type='Blog'>
                <b:includable id='main' var='top'>
                    <!-- Loop through posts -->
                    <b:loop values='data:posts' var='post'>
                        <div class='post-outer'>
                            <h2 class='post-title'>
                                <b:if cond='data:post.link'>
                                    <a expr:href='data:post.link'><data:post.title/></a>
                                <b:else/>
                                    <data:post.title/>
                                </b:if>
                            </h2>
                            <div class='post-body'>
                                <data:post.body/>
                            </div>
                        </div>
                    </b:loop>
                    <!-- Pagination -->
                    <div class='blog-pager'>
                         <b:if cond='data:newerPageUrl'>
                             <a class='btn btn-secondary' expr:href='data:newerPageUrl' style='float:left'>Newer Posts</a>
                         </b:if>
                         <b:if cond='data:olderPageUrl'>
                             <a class='btn btn-secondary' expr:href='data:olderPageUrl' style='float:right'>Older Posts</a>
                         </b:if>
                    </div>
                </b:includable>
            </b:widget>
        </b:section>
    </div>

    <!-- Footer -->
    <footer>
        <div class="container footer-grid">
            <!-- Contact -->
            <div class="footer-col">
                <h3>Contact Details</h3>
                <ul style="display: flex; flex-direction: column; gap: 1rem;">
                    <li style="display: flex; alignItems: center; gap: 0.75rem;">
                        <i data-lucide="user" color="#ff9900" width="18"></i>
                        <span>Vijay Savani</span>
                    </li>
                    <li style="display: flex; alignItems: center; gap: 0.75rem;">
                        <i data-lucide="mail" color="#ff9900" width="18"></i>
                        <a href="mailto:contact@bechdenge.com" style="text-decoration: none; color: white;">contact@bechdenge.com</a>
                    </li>
                </ul>
            </div>

            <!-- Social -->
             <div class="footer-col">
                <h3>Connect With Us</h3>
                <div class="footer-icons">
                    <a href="https://www.linkedin.com/in/vijay-savani-7b94111b5/" class="footer-icon-link">
                        <i data-lucide="linkedin" color="white" width="20"></i>
                    </a>
                    <a href="https://www.instagram.com/vijaysavani_champion/" class="footer-icon-link">
                         <i data-lucide="instagram" color="white" width="20"></i>
                    </a>
                </div>
            </div>

             <!-- Quick Links -->
            <div class="footer-col">
                <h3>Quick Links</h3>
                <ul style="display: flex; flex-direction: column; gap: 0.5rem;">
                    <li><a href="/p/services.html" style="text-decoration: none; color: white;">Services</a></li>
                    <li><a href="/p/gallery.html" style="text-decoration: none; color: white;">Photo Gallery</a></li>
                </ul>
            </div>
        </div>
        
        <div style="width: 100%; height: 1px; background: rgba(255,255,255,0.1);"></div>
        
        <div style="text-align: center; padding: 2rem 1rem; font-size: 0.9rem; color: #ccc;">
            <p>&copy; <script>document.write(new Date().getFullYear())</script> Bechdenge.com. All rights reserved.</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Init Lucide
        lucide.createIcons();

        // Mobile Menu
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const mobileMenu = document.getElementById('mobile-menu');
        if(toggleBtn){
            toggleBtn.addEventListener('click', function() {
                if (mobileMenu.style.display === 'none' || mobileMenu.style.display === '') {
                    mobileMenu.style.display = 'flex';
                } else {
                    mobileMenu.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
